{
  "name": "enquiry-website-monorepo",
  "version": "1.0.0",
  "description": "QuickEnquiry MERN Stack Application (Frontend & Backend)",
  "private": true,
  "scripts": {
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "server": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "keywords": ["mern", "react", "express", "mongodb", "node", "vite"],
  "author": "QuickEnquiry Team",
  "license": "ISC"
}
